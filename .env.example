# ══════════════════════════════════════════════════════════════════════════════
#  NeuroLearn AI – Environment Variables
#  Copy this file to .env and fill in every value before running the project.
#  Never commit the real .env file.
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL (Section 2.6) ──────────────────────────────────────────────────
POSTGRES_USER=neurolearn
POSTGRES_PASSWORD=changeme
POSTGRES_DB=neurolearn
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://neurolearn:changeme@db:5432/neurolearn

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=replace_with_generated_secret
JWT_EXPIRES_IN=8h

# ── ML Service ────────────────────────────────────────────────────────────────
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
ML_API_KEY=replace_with_generated_key
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_TIMEOUT_MS=5000

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PREDICTION_CACHE_MINUTES=15

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ── ML Model / Graph paths ────────────────────────────────────────────────────
MODEL_PATH=models/model_v1.joblib
GRAPH_PATH=data/graph.json

